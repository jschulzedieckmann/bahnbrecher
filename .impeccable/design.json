  "components": [
    {
      "name": "Knopf",
      "kind": "button",
      "refersTo": "knopf",
      "description": "Standardaktion: dunkle Pille mit Kontur.",
      "html": "<button class=\"ds-knopf\">Speichern</button>",
      "css": ".ds-knopf{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:10px 18px;border:3px solid var(--ink,#000c16);border-radius:999px;font:800 16px/1.1 var(--font-ui,Archivo,system-ui,sans-serif);cursor:pointer;transition:transform 120ms cubic-bezier(0.16,1,0.3,1),background-color 150ms ease;background:var(--ink,#000c16);color:var(--creme,#fef7de)}.ds-knopf:hover{background:var(--blau-tief,#075a85)}.ds-knopf:active{transform:scale(0.97)}.ds-knopf:focus-visible{outline:3px solid var(--blau,#0f8ac7);outline-offset:2px}"

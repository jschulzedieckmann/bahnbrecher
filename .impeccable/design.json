      "html": "<label class=\"ds-feld\"><span class=\"ds-feld-name\">E-Mail</span><input class=\"ds-eingabe\" type=\"email\" placeholder=\"name@beispiel.de\"><span class=\"ds-hinweis\">Die Adresse, mit der du eingeladen wurdest.</span></label>",
      "css": ".ds-feld{display:grid;gap:6px;font-family:var(--font-ui,Archivo,system-ui,sans-serif);color:var(--ink,#000c16)}.ds-feld-name{font-weight:700}.ds-hinweis{font-size:14px;color:var(--ink-weich,#3a3f45)}.ds-eingabe{min-height:48px;padding:10px 14px;border:2px solid var(--ink,#000c16);border-radius:9px;background:var(--weiss,#fffdf6);color:var(--ink,#000c16);font:500 16px/1.3 var(--font-ui,Archivo,system-ui,sans-serif);caret-color:var(--rot,#eb0620)}.ds-eingabe:focus-visible{outline:3px solid var(--blau,#0f8ac7);outline-offset:0}"
    },
    {
      "name": "Banderole",
      "kind": "card",
      "refersTo": "banderole-kopf-rot",
      "description": "Weißes Blatt mit rotem oder blauem Versal-Kopf.",
      "html": "<section class=\"ds-blatt\"><h2 class=\"ds-banderole\">Amtierende Gossenjungen</h2><p class=\"ds-blatt-inhalt\">Teilen sich den Titel. Gossen am 25.06.</p></section><section class=\"ds-blatt\" style=\"margin-top:14px\"><h2 class=\"ds-banderole ds-banderole--blau\"><span>Danach</span><a href=\"#\">Alle Termine</a></h2><p class=\"ds-blatt-inhalt\">Sonst steht gerade nichts an.</p></section>",
      "css": ".ds-blatt{background:var(--weiss,#fffdf6);border:3px solid var(--ink,#000c16);border-radius:14px;overflow:hidden;font-family:var(--font-ui,Archivo,system-ui,sans-serif);color:var(--ink,#000c16)}.ds-blatt-inhalt{margin:0;padding:14px 16px}.ds-banderole{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:0;padding:8px 16px;border-bottom:3px solid var(--ink,#000c16);background:var(--rot,#eb0620);color:#fff;font-size:15px;font-weight:800;font-stretch:78%;text-transform:uppercase;letter-spacing:0.06em}.ds-banderole--blau{background:var(--blau,#0f8ac7);color:var(--ink,#000c16)}.ds-banderole a{color:inherit;font-size:14px;font-weight:700;text-transform:none;letter-spacing:0;text-underline-offset:3px;text-decoration-thickness:2px}.ds-banderole a:hover{text-decoration-thickness:3px}.ds-banderole a:focus-visible{outline:3px solid var(--ink,#000c16);outline-offset:2px}"
    },
    {
      "name": "Plakatblock mit Störer",
      "kind": "custom",
      "refersTo": "plakat",
      "description": "Nächster Kegelabend: gelbe Fläche, Datum in Plakatschrift, roter Störer.",
      "html": "<section class=\"ds-plakat\"><h2 class=\"ds-versal\">Nächster Kegelabend</h2><p class=\"ds-datum\">Fr 07.11.</p><p class=\"ds-ort\">Kegelbahn Lüdinghausen</p><div class=\"ds-stoerer\"><span class=\"ds-stoerer-klein\">noch</span><span class=\"ds-stoerer-zahl\">5</span><span class=\"ds-stoerer-klein\">Tage</span></div></section>",
      "css": ".ds-plakat{position:relative;display:grid;gap:8px;margin-top:16px;padding:18px 18px 20px;background:var(--gelb,#fed51c);border:3px solid var(--ink,#000c16);border-radius:18px;color:var(--ink,#000c16);font-family:var(--font-ui,Archivo,system-ui,sans-serif)}.ds-versal{margin:0;font-size:16px;font-weight:800;font-stretch:78%;text-transform:uppercase;letter-spacing:0.06em;padding-right:64px}.ds-datum{margin:2px 0;font-family:var(--font-plakat,Shrikhand,cursive);font-size:56px;line-height:1.02;color:var(--gelb,#fed51c);text-shadow:0.06em 0.06em 0 var(--rot,#eb0620),-0.035em -0.035em 0 var(--ink,#000c16),0.035em -0.035em 0 var(--ink,#000c16),-0.035em 0.035em 0 var(--ink,#000c16),0.035em 0.035em 0 var(--ink,#000c16),0 0.045em 0 var(--ink,#000c16),0.045em 0 0 var(--ink,#000c16),0 -0.045em 0 var(--ink,#000c16),-0.045em 0 0 var(--ink,#000c16)}.ds-ort{margin:0;font-weight:800;font-size:17px}.ds-stoerer{position:absolute;top:-16px;right:-8px;width:86px;height:86px;display:grid;place-content:center;justify-items:center;background:var(--rot,#eb0620);color:#fff;border:3px solid var(--ink,#000c16);border-radius:50%;transform:rotate(9deg)}.ds-stoerer-klein{font:800 11px/1 var(--font-ui,Archivo,system-ui,sans-serif);font-stretch:80%;text-transform:uppercase;letter-spacing:0.06em}.ds-stoerer-zahl{font-family:var(--font-plakat,Shrikhand,cursive);font-size:32px;line-height:1;color:var(--gelb,#fed51c);text-shadow:2px 2px 0 var(--ink,#000c16)}"
    },
    {
      "name": "Rangliste",
      "kind": "custom",
      "refersTo": "rangliste",
      "description": "Balken exakt proportional zum Wert, Wert rechtsbündig; gewählter Spieler hervorgehoben.",
      "html": "<ol class=\"ds-rang\"><li><span class=\"ds-platz\">1.</span><span>Hendrik</span><span class=\"ds-spur\"><span class=\"ds-balken\" style=\"width:100%\"></span></span><span class=\"ds-wert\">4</span></li><li class=\"ds-hervor\"><span class=\"ds-platz\">2.</span><span>Sven</span><span class=\"ds-spur\"><span class=\"ds-balken\" style=\"width:75%\"></span></span><span class=\"ds-wert\">3</span></li><li><span class=\"ds-platz\">3.</span><span>Julian</span><span class=\"ds-spur\"><span class=\"ds-balken\" style=\"width:50%\"></span></span><span class=\"ds-wert\">2</span></li></ol>",
      "css": ".ds-rang{list-style:none;margin:0;padding:12px 16px 14px;display:grid;gap:10px;font:700 16px/1.45 var(--font-ui,Archivo,system-ui,sans-serif);font-variant-numeric:tabular-nums;color:var(--ink,#000c16)}.ds-rang li{display:grid;grid-template-columns:2.1em minmax(5em,8em) minmax(60px,1fr) 2.4em;align-items:center;gap:10px;border-radius:8px}.ds-platz{color:var(--ink-weich,#3a3f45)}.ds-spur{display:block;height:16px}.ds-balken{display:block;height:100%;min-width:6px;box-sizing:border-box;background:var(--gelb,#fed51c);border:2px solid var(--ink,#000c16);border-radius:8px}.ds-wert{text-align:right;font-size:17px}.ds-hervor{background:var(--gelb,#fed51c);outline:2px solid var(--ink,#000c16);outline-offset:3px}.ds-hervor .ds-balken{background:var(--rot,#eb0620)}"
    },
    {
      "name": "Zustandszeichen",
      "kind": "chip",
      "refersTo": "nicht-erfasst",
      "description": "Nicht erfasst als gestricheltes ?-Kästchen, nicht dabei als Durchstreichung.",
      "html": "<p class=\"ds-zustand\">Pudel: <span class=\"ds-nicht-erfasst\">?</span> · <span class=\"ds-nicht-dabei\">Nico</span></p>",
      "css": ".ds-zustand{font:400 16px/1.45 var(--font-ui,Archivo,system-ui,sans-serif);color:var(--ink,#000c16)}.ds-nicht-erfasst{display:inline-grid;place-items:center;min-width:2em;padding:0 6px;border:2px dashed var(--ink-weich,#3a3f45);border-radius:6px;color:var(--ink-weich,#3a3f45);font-weight:700}.ds-nicht-dabei{text-decoration:line-through;text-decoration-thickness:2px;color:var(--ink-weich,#3a3f45)}"
    },
    {
      "name": "Tab-Leiste (Handy)",
      "kind": "nav",
      "refersTo": "tab-aktiv",
      "description": "Feste Tab-Leiste unten, aktive Seite als gelbe Pille.",
      "html": "<nav class=\"ds-tabs\"><a class=\"ds-tab\" aria-current=\"page\" href=\"#\"><span class=\"ds-tab-icon\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 10l9-7 9 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg></span>Start</a><a class=\"ds-tab\" href=\"#\"><span class=\"ds-tab-icon\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 10h18\"/></svg></span>Termine</a><a class=\"ds-tab\" href=\"#\"><span class=\"ds-tab-icon\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 3v18h18\"/><path d=\"M8 17v-4M13 17V9M18 17v-7\"/></svg></span>Statistik</a></nav>",
      "css": ".ds-tabs{display:grid;grid-template-columns:repeat(3,1fr);padding:6px 4px 8px;background:var(--creme,#fef7de);border-top:3px solid var(--ink,#000c16);font-family:var(--font-ui,Archivo,system-ui,sans-serif)}.ds-tab{display:grid;justify-items:center;gap:3px;padding:4px 0;font-weight:700;font-size:12px;text-decoration:none;color:var(--ink,#000c16)}.ds-tab-icon{display:grid;place-items:center;width:44px;height:30px;border-radius:999px;border:2px solid transparent;transition:background-color 150ms ease}.ds-tab[aria-current=\"page\"] .ds-tab-icon{background:var(--gelb,#fed51c);border-color:var(--ink,#000c16)}.ds-tab:focus-visible{outline:3px solid var(--blau,#0f8ac7);outline-offset:2px;border-radius:6px}"
    },
    {
      "name": "Leiste (PC)",
      "kind": "nav",
      "refersTo": "rail-link-aktiv",
      "description": "Blaue Leiste über die volle Höhe, aktive Seite als gelbe Pille.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-rail-link\" aria-current=\"page\" href=\"#\">Start</a><a class=\"ds-rail-link\" href=\"#\">Termine</a><a class=\"ds-rail-link\" href=\"#\">Spieltage</a><a class=\"ds-rail-link\" href=\"#\">Statistik</a></nav>",
      "css": ".ds-rail{display:grid;gap:4px;width:232px;padding:20px 14px;background:var(--blau,#0f8ac7);border-right:3px solid var(--ink,#000c16);font-family:var(--font-ui,Archivo,system-ui,sans-serif)}.ds-rail-link{display:flex;align-items:center;gap:12px;min-height:44px;padding:8px 14px;border:2px solid transparent;border-radius:999px;font-weight:700;color:var(--ink,#000c16);text-decoration:none;transition:background-color 150ms ease}.ds-rail-link:hover{background:var(--blau-tief,#075a85);color:#fff}.ds-rail-link[aria-current=\"page\"]{background:var(--gelb,#fed51c);border-color:var(--ink,#000c16);color:var(--ink,#000c16)}.ds-rail-link:focus-visible{outline:3px solid var(--blau,#0f8ac7);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "Das Brauerei-Plakat am Tresen",
    "overview": "Die App sieht aus wie das Vereinsplakat einer Kneipe der 50er und 60er Jahre, abgeleitet aus dem Logo des Clubs: Cremegrund, fast schwarze Konturen von 3px, Logo-Blau, Gelb und Rot als satte Druckfarben. Termine und Titel stehen da, als wären sie gedruckt: das Datum des nächsten Kegelabends und die Namen der Titelträger tragen die Logo-Schrift Shrikhand mit roter Versatzkontur, alles andere ist ruhige, gut lesbare Standard-UI in Archivo.\n\nDas Plakat ist auf wenige Stellen konzentriert: Kopfleiste, PC-Leiste, Banderolen-Köpfe, der gelbe Plakatblock mit Störer und die Kontur um jede Fläche. Statistik, Tabellen, Formulare und die Spieltag-Erfassung bleiben ruhig und dicht. Die Dichte ist mittel; Handy und PC sind gleichwertig.\n\nAbgelehnt ist das Standard-Dashboard mit grauen Kacheln und einer einzigen Akzentfarbe.",
    "keyCharacteristics": [
      "Creme-Grund, jede Fläche mit 3px Fast-Schwarz umrandet, runde Ecken von 14 bis 18px.",
      "Shrikhand mit Versatzkontur nur für Markenmomente; alles Übrige in Archivo.",
      "Banderolen: weiße Blätter mit rotem oder blauem Kopf in schmalen Versalien.",
      "Keine Box-Schatten, keine weichen Verläufe; Tiefe entsteht aus Kontur und Farbfläche.",
      "Zustände zeigen sich in der Form, nicht nur in der Farbe."
    ],
    "rules": [
      {
        "name": "The Zwei-Köpfe Rule",
        "body": "Banderolen-Köpfe sind rot (weißer Text) oder blau (dunkler Text). Gelbe oder schwarze Köpfe gibt es nicht; Gelb gehört dem Plakatblock und dem aktiven Zustand.",
        "section": "colors"
      },
      {
        "name": "The Gelb-heißt-hier Rule",
        "body": "Gelb markiert, was jetzt zählt: der nächste Termin, die aktive Seite, der eigene Name, der gewählte Spieler. Es wird nicht als Dekorfläche verteilt.",
        "section": "colors"
      },
      {
        "name": "The Markenmoment Rule",
        "body": "Shrikhand steht nur an Markenmomenten: Wortmarke, Plakatdatum, Störer-Zahl, Titelträger, Seitentitel, „Pudel!“ und „Gut Holz!“. Kartentitel, Zahlen, Tabellen und Formulare sind Archivo.",
        "section": "typography"
      },
      {
        "name": "The Gleiche-Ziffern Rule",
        "body": "Zahlen stehen in gleich breiten Ziffern (tabular-nums ist am body gesetzt) und in Tabellen und Ranglisten rechtsbündig.",
        "section": "typography"
      },
      {
        "name": "The Kontur-statt-Schatten Rule",
        "body": "Tiefe kommt von der 3px-Kontur in Fast-Schwarz. Versatz gehört der Plakatschrift, nicht Flächen oder Knöpfen.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** jede Fläche mit 3px Fast-Schwarz umranden und 14 bis 18px runden.",
      "**Do** Banderolen-Köpfe rot mit weißem Text oder blau mit dunklem Text setzen.",
      "**Do** Shrikhand nur für Wortmarke, Plakatdatum, Störer-Zahl, Titelträger, Seitentitel, „Pudel!“ und „Gut Holz!“ verwenden.",
      "**Do** Zustände über die Form zeigen: gestricheltes „?“-Kästchen für nicht erfasst, Durchstreichung für nicht dabei.",
      "**Do** Ranglisten-Balken exakt proportional zum Wert zeichnen und Zahlen rechtsbündig in gleich breiten Ziffern setzen.",
      "**Do** am PC die blaue Leiste über die volle Höhe laufen lassen, am Handy die Tab-Leiste mit gelber Aktiv-Pille zeigen."
    ],
    "donts": [
      "**Don't** gelbe oder schwarze Banderolen-Köpfe bauen.",
      "**Don't** Kartentitel, Zahlen, Tabellen oder Formulare in Shrikhand setzen.",
      "**Don't** Plakateffekte (Versatzschrift, Störer, Drehung) in Statistik, Tabellen, Formulare oder die Erfassung tragen; dort zeigt sich das Plakat nur in Kopfleiste, Banderolen-Köpfen und Kontur.",
      "**Don't** Kicker- oder Eyebrow-Zeilen über Überschriften setzen.",
      "**Don't** Box-Schatten oder weiche Verläufe für Tiefe einsetzen.",
      "**Don't** einen Zustand allein über Farbe ausdrücken."
    ]
  }
}

# Vorlage für .env.local. Die echte Datei wird nie eingecheckt oder hochgeladen.
# Werte stehen im Supabase-Dashboard unter Project Settings → API Keys.

# Projekt-Adresse, z. B. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Öffentlicher Schlüssel (publishable / anon). Darf im Browser stehen.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Geheimer Schlüssel (secret / service_role). Nur auf dem Server.
# Braucht die Verwaltung zum Anlegen von Mitgliedern und Zurücksetzen von Passwörtern.
SUPABASE_SECRET_KEY=

# Das gemeinsame Startpasswort für neue und zurückgesetzte Zugänge.
START_PASSWORT=

# Nur auf Vercel nötig: Schutz für den täglichen Wachhalte-Aufruf /api/wach.
# Beliebige lange Zeichenkette, z. B. aus einem Passwort-Generator.
CRON_SECRET=
